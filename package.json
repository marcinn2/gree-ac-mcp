{
  "name": "gree-ac-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for controlling GREE/EWPE-compatible WiFi air conditioners over their native UDP protocol",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gree-ac-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "config.example.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http",
    "dev:stdio": "tsx src/index.ts --transport stdio",
    "dev:http": "tsx src/index.ts --transport http",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
